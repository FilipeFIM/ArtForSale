# ==============================================================================
# ART FOR SALE - Proteção de Diretório de Assets / Imagens
# Bloqueia estritamente a execução de qualquer script ou arquivo executável
# ==============================================================================

# Bloqueia execução de scripts PHP e quaisquer arquivos executáveis
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|cgi|pl|py|sh|bash|exe|bat|cmd|com)$">
    Order allow,deny
    Deny from all
    Require all denied
</FilesMatch>

# Desativa engine do PHP
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Força nosniff
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
