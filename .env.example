# Configurações do Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE_BACKEND_OPCIONAL
SUPABASE_STORAGE_BUCKET=artworks

# Limite de Tamanho de Imagem (Megabytes) e Extensões Permitidas
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# Dados de Contato e Curadoria
SITE_CONTACT_EMAIL=artforsale1944@gmail.com
CURADORA_WHATSAPP=555191140044
ATENDIMENTO_WHATSAPP=5551991266414

# Autenticação Administrativa
# O acesso administrativo é gerenciado exclusivamente via Supabase Auth (auth.users)
# com perfil administrativo na tabela public.profiles (role = 'admin').
